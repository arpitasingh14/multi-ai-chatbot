# Application
APP_NAME="Secure Multimodal AI Companion"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
API_V1_STR="/api/v1"

# Security & CORS
SECRET_KEY="replace-this-with-a-secure-random-secret-in-production"
ALLOWED_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"
MAX_UPLOAD_SIZE_MB=15

# Database Configuration (MySQL Primary, SQLite Fallback supported)
# Production MySQL URL format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="sqlite:///./storage/companion.db"
# DATABASE_URL="mysql+pymysql://companion_user:companion_pass@localhost:3306/companion_db"

# AI Provider Configuration (Options: "gemini", "openai", "mock")
LLM_PROVIDER="mock"
EMBEDDING_PROVIDER="mock"
LLM_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# External API Keys (Leave blank when using LLM_PROVIDER="mock")
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Vector Store Configuration (Options: "memory", "chroma")
VECTOR_STORE_BACKEND="memory"
CHROMA_PERSIST_DIRECTORY="./storage/vector_db"

# RAG Configuration
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65

# Audio Configuration (Options: "edge_tts", "mock")
TTS_PROVIDER="edge_tts"
TTS_VOICE="en-US-AriaNeural"
STT_PROVIDER="mock"

# Storage Directories
UPLOAD_DIR="./storage/uploads"
PROCESSED_DIR="./storage/processed"
